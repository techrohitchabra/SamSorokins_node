<!DOCTYPE html>
<html>
  <head>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        background-color: #f8fafc;
        color: #334155;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 800px;
        width: 95%;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 30px;
        margin: 0 auto;
        border: 1px solid #e2e8f0;
      }
      .header {
        font-size: 20px;
        font-weight: bold;
        color: #1e3a8a;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 12px;
        margin-bottom: 20px;
      }
      .intro {
        font-size: 15px;
        line-height: 1.5;
        color: #475569;
        margin-bottom: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }
      th {
        background-color: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-align: left;
        padding: 10px;
        font-size: 13px;
        border-bottom: 2px solid #cbd5e1;
      }
      td {
        padding: 10px;
        font-size: 13px;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
      }
      .status-pill {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
      }
      .status-to-be-returned {
        background-color: #fef3c7;
        color: #92400e;
      }
      .status-checked-out {
        background-color: #dbeafe;
        color: #1e40af;
      }
      .footer {
        text-align: center;
        margin-top: 30px;
        font-size: 12px;
        color: #94a3b8;
        border-top: 1px solid #f1f5f9;
        padding-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">🔑 Weekly Outstanding Keys Reminder</div>
      <div class="intro">
        Hello <strong><%= vendor || "Vendor / User" %></strong>,<br /><br />
        This is an automated reminder regarding outstanding key requests
        assigned to you that require attention or return:
      </div>

      <table>
        <thead>
          <tr>
            <th>Service Issue #</th>
            <th>Property</th>
            <!-- <th>Unit</th> -->
            <th>Keys Needed</th>
            <th>Pick Up Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% keys.forEach(function(key) { %>
          <tr>
            <td><strong><%= key.serviceIssue || "N/A" %></strong></td>
            <td><%= key.property || "N/A" %><% if (key.unit) { %> - Unit <%= key.unit %><% } %></td>
            <td><%= key.keysNeeded || "N/A" %></td>
            <td><%= key.pickUpDateTime || "N/A" %></td>
            <td>
              <span
                class="status-pill <%= key.status === 'To Be Returned' ? 'status-to-be-returned' : 'status-checked-out' %>"
              >
                <%= key.status %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="intro">
        If you have completed your work, please return the keys to the key vault
        as soon as possible.
      </div>

      <div class="footer">
        This is an automated weekly notification from the Premium Property Key
        Vault.
      </div>
    </div>
  </body>
</html>
